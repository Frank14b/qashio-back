# Validated at startup by src/shared/config/env.ts (zod): the API refuses to boot and lists every
# invalid/missing value. In NODE_ENV=production, EMAIL_OTP_MODE must be live and JWT_ACCESS_SECRET
# a unique 32+ character secret.
PORT=3000
# development | production — Swagger at /docs is disabled when NODE_ENV=production
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (Next.js local default: 3001)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/qashio_points
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional override: REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Schema is managed by migrations only (`npm run migration:run`); synchronize is always off.
RUN_MIGRATIONS=true
# Currency seed: idempotent upsert of ISO codes on boot (default true).
# Set SEED_CURRENCIES=false to skip and run `npm run seed` manually.
# SEED_CURRENCIES=true

# Email OTP: fixed = always 123456 (dev); live = random 6-digit
EMAIL_OTP_MODE=fixed
EMAIL_OTP_TTL_SECONDS=600

# Logging (pino): trace | debug | info | warn | error. Pretty output unless NODE_ENV=production.
LOG_LEVEL=info

# Rate limiting (Redis-backed, per client IP): global requests per minute.
# Auth routes (login, register, OTP, password reset) are capped at 5/min, refresh at 30/min.
RATE_LIMIT_PER_MINUTE=120
# Set when behind a proxy/load balancer so the real client IP is used (e.g. 1 = one hop).
# TRUST_PROXY=1

# Health check (/health): memory limits that mark the app as down
# HEALTH_MEMORY_HEAP_MB=512
# HEALTH_MEMORY_RSS_MB=1024
# APP_VERSION=  # reported by /health (e.g. git SHA in CI)

# Nodemailer / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qashio.local

# Sentry (off by default). Enabling requires SENTRY_DSN.
SENTRY_ENABLED=false
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
